# ── Backend API URL ──────────────────────────
# The Express backend's public URL.
# On the CLIENT side: Used by Next.js rewrites to proxy /api/* → Render.
#   Browser makes same-origin requests to Vercel, which proxies to Render.
#   This eliminates CORS entirely.
# On the SERVER side: Used by authOptions.js for direct server→Render calls.
# No trailing slash.
# Example: NEXT_PUBLIC_API_URL=https://your-api.railway.app
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Express API URL (optional alias) ────────
# Same as NEXT_PUBLIC_API_URL. Used by next.config.js rewrites.
# If both are set, EXPRESS_API_URL takes precedence for rewrites.
# EXPRESS_API_URL=https://your-api.railway.app

# ── NextAuth ─────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── OAuth Providers (optional) ───────────────
# Only needed if using Google/GitHub login alongside Credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_AUTH_CLIENT_ID=
# GITHUB_AUTH_CLIENT_SECRET=
