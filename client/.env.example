# ── Backend API URL ──────────────────────────
# The Express backend's public URL. All browser fetch() calls go here.
# Must match FRONTEND_URL on the backend (the backend uses it for CORS).
# No trailing slash.
# Example: NEXT_PUBLIC_API_URL=https://your-api.railway.app
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── NextAuth ─────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── OAuth Providers (optional) ───────────────
# Only needed if using Google/GitHub login alongside Credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_AUTH_CLIENT_ID=
# GITHUB_AUTH_CLIENT_SECRET=
