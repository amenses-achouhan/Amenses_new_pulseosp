# ============================================================================
# PulseOps Client — Required Environment Variables
# Copy this file to client/.env and fill in real values.
# Variables marked [REQUIRED] must be set for the client to start.
# Variables marked [OPTIONAL] enable optional OAuth providers.
# ============================================================================

# --- Backend API URL ---
# [REQUIRED] URL of the Express backend server
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- NextAuth ---
# [REQUIRED] Secret for NextAuth.js session encryption (min 32 characters)
NEXTAUTH_SECRET=

# [REQUIRED] Canonical URL of the Next.js app (must match NEXTAUTH_SECRET)
NEXTAUTH_URL=http://localhost:3000

# --- OAuth (Google) ---
# [OPTIONAL] Google OAuth 2.0 credentials (for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth (GitHub) ---
# [OPTIONAL] GitHub OAuth App credentials (for GitHub sign-in)
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=
